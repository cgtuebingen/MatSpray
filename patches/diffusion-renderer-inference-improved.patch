+def srgb_to_linear_01(srgb_image):
+    """Convert sRGB (uint8 0-255 or float [0..1]) to linear RGB in [0,1] float."""
+    img = srgb_image.astype(np.float32)
+    if img.max() > 1.0:
+        img = img / 255.0
+    mask = img > 0.04045
+    img[mask] = np.power((img[mask] + 0.055) / 1.055, 2.4)
+    img[~mask] = img[~mask] / 12.92
+    return np.clip(img, 0.0, 1.0)
+
+
+def linear_to_srgb_01(linear_image):
+    """Convert linear RGB in [0,1] to sRGB (uint8 0-255 or float [0..1])"""
+    img = linear_image.astype(np.float32)
+    mask = img > 0.0031308
+    img[mask] = np.power(img[mask], 1.0 / 2.4) * 1.055 - 0.055
+    img[~mask] = img[~mask] * 12.92
+    return np.clip(img, 0.0, 1.0)
+
