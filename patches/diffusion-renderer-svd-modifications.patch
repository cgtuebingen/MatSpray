+def render_environment_background(env_ldr_tensor, target_size=None):
+    """
+    Render the environment map as a full 360° background from camera perspective.
+    
+    Args:
+        env_ldr_tensor: Tensor [H, W, 3] with environment map in camera view
+        target_size: Optional tuple (width, height) to resize to
+    
+    Returns:
+        PIL Image of the environment background
+    """
+    # Convert environment tensor to numpy and ensure it's in [0,1] range
+    env_array = env_ldr_tensor.cpu().numpy()
+    if env_array.max() <= 1.0:
+        env_array = env_array  # Already in [0,1]
+    else:
+        env_array = env_array / 255.0  # Convert from [0,255] to [0,1]
+    
+    # Resize if needed
+    if target_size and env_array.shape[:2] != (target_size[1], target_size[0]):
+        from PIL import Image as PILImage
+        env_pil = PILImage.fromarray((env_array * 255).astype(np.uint8))
+        env_pil = env_pil.resize(target_size, PILImage.LANCZOS)
+        env_array = np.array(env_pil).astype(np.float32) / 255.0
+    
+    # Convert back to PIL Image
+    env_uint8 = (env_array * 255).astype(np.uint8)
+    return Image.fromarray(env_uint8)
+
